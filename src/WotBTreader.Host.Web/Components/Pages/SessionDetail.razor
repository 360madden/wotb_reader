@page "/sessions/{BattleSessionId:guid}"
@using WotBTreader.Host.Web.Contracts
@using WotBTreader.Host.Web.Services
@inject IDashboardReadClient ReadClient

<PageTitle>Session</PageTitle>

<p><a href="/">← Sessions</a></p>

@if (_error is not null)
{
    <p class="text-danger" role="alert">@_error</p>
}
else if (_loading)
{
    @* Loading skeleton — animated shimmer blocks *@
    <div class="card-dashboard">
        <div class="skeleton" style="width:50%;height:1.5rem;margin-bottom:1rem"></div>
        <div class="skeleton-row"><div class="skeleton-cell" style="flex:0 0 25%"></div><div class="skeleton-cell" style="flex:0 0 60%"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell" style="flex:0 0 25%"></div><div class="skeleton-cell" style="flex:0 0 40%"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell" style="flex:0 0 25%"></div><div class="skeleton-cell" style="flex:0 0 50%"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell" style="flex:0 0 25%"></div><div class="skeleton-cell" style="flex:0 0 35%"></div></div>
        <div style="margin-top:1rem"><div class="skeleton" style="width:30%;height:1.2rem;margin-bottom:0.5rem"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
    </div>
}
else if (_detail is null)
{
    <div class="empty-state">
        <div class="empty-state-icon">🔍</div>
        <div class="empty-state-text">Session not found</div>
        <div class="empty-state-hint">No battle session matched that identifier.</div>
    </div>
}
else
{
    <div class="card-dashboard">
    <h1>@( _detail.Session?.MapName ?? "Session" )</h1>

    <dl class="row">
        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@_detail.DecodeRun.Status</dd>
        <dt class="col-sm-3">Game version</dt>
        <dd class="col-sm-9">@( _detail.Session?.GameVersion ?? "unknown" )</dd>
        <dt class="col-sm-3">Decoder</dt>
        <dd class="col-sm-9">@_detail.DecodeRun.DecoderId @_detail.DecodeRun.DecoderVersion</dd>
        <dt class="col-sm-3">Positions</dt>
        <dd class="col-sm-9">
            @_detail.Positions.Count shown
            @if (_detail.PositionsTruncated)
            {
                <span>(truncated; @_detail.TotalPositionCount total)</span>
            }
        </dd>
        <dt class="col-sm-3">Events / raw records</dt>
        <dd class="col-sm-9">@_detail.EventCount / @_detail.RawRecordCount</dd>
        @if (!string.IsNullOrWhiteSpace(_detail.DecodeRun.FailureSummary))
        {
            <dt class="col-sm-3">Failure</dt>
            <dd class="col-sm-9">@_detail.DecodeRun.FailureCode — @_detail.DecodeRun.FailureSummary</dd>
        }
    </dl>

    @if (_detail.Warnings.Count > 0)
    {
        <h2>Warnings</h2>
        <ul>
            @foreach (string warning in _detail.Warnings)
            {
                <li>@warning</li>
            }
        </ul>
    }

    @* ── Battle stats ── *@
    @if (_detail.Events.Count > 0)
    {
        <h2>Battle Stats</h2>
        <div class="row mb-3">
            <div class="col-auto me-4">
                <span class="badge bg-primary fs-6">🔵 @_dmgTeam1.ToString("N0") dmg taken</span>
                <span class="badge bg-primary ms-2">@_killsTeam1 kills</span>
            </div>
            <div class="col-auto">
                <span class="badge bg-danger fs-6">🔴 @_dmgTeam2.ToString("N0") dmg taken</span>
                <span class="badge bg-danger ms-2">@_killsTeam2 kills</span>
            </div>
        </div>
    }

    <h2>Participants</h2>
    @if (_detail.Participants.Count == 0)
    {
        <p>No participants in this projection.</p>
    }
    else
    {
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Clan</th>
                    <th scope="col">Team</th>
                    <th scope="col">Tank</th>
                    <th scope="col">Bot status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (ParticipantResponse participant in _detail.Participants)
                {
                    <tr>
                        <td>@(participant.PlayerName ?? "unknown")</td>
                        <td>@(participant.ClanTag ?? "—")</td>
                        <td>@(participant.TeamNumber?.ToString() ?? "—")</td>
                        <td>@(participant.TankName ?? participant.TankId ?? "unknown")</td>
                        <td>@participant.BotStatus (@participant.BotStatusConfidence)</td>
                    </tr>
                }
            </tbody>
        </table>
    }

    @* ── Events table ── *@
    @if (_detail.Events.Count > 0)
    {
        <h2>Events</h2>
        <div class="mb-2">
            <label class="form-label me-2">Filter:</label>
            <select class="form-select form-select-sm d-inline-block w-auto" @bind="_eventKindFilter">
                <option value="">All kinds</option>
                <option value="Damage">Damage</option>
                <option value="Destroyed">Destroyed</option>
                <option value="BattleEnded">Battle Ended</option>
                <option value="ParticipantObserved">Participant Observed</option>
            </select>
        </div>
        <table class="table table-sm table-striped">
            <thead>
                <tr>
                    <th scope="col" style="width:80px">Time</th>
                    <th scope="col">Kind</th>
                    <th scope="col">Participant</th>
                    <th scope="col">Summary</th>
                </tr>
            </thead>
            <tbody>
                @foreach (EventResponse evt in FilteredEvents())
                {
                    <tr>
                        <td>@evt.ReplayTime.ToString(@"mm\:ss")</td>
                        <td>@evt.Kind</td>
                        <td>@ParticipantName(evt.ParticipantId)</td>
                        <td>@evt.Summary</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    </div>
}

@code {
    [Parameter]
    public Guid BattleSessionId { get; set; }

    private SessionDetailResponse? _detail;
    private bool _loading = true;
    private string? _error;
    private string _eventKindFilter = "";
    private int _dmgTeam1, _dmgTeam2, _killsTeam1, _killsTeam2;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _error = null;
        _detail = null;
        _eventKindFilter = "";
        try
        {
            _detail = await ReadClient.GetSessionAsync(BattleSessionId, CancellationToken.None);
            ComputeStats();
        }
        catch (Exception exception)
        {
            _error = $"Could not load session ({exception.GetType().Name}).";
        }
        finally
        {
            _loading = false;
        }
    }

    private int? TeamOf(string? participantId)
    {
        if (participantId is null || _detail is null) return null;
        foreach (ParticipantResponse p in _detail.Participants)
        {
            if (p.ParticipantId == participantId)
                return p.TeamNumber;
        }
        return null;
    }

    private string ParticipantName(string? participantId)
    {
        if (participantId is null || _detail is null) return "—";
        foreach (ParticipantResponse p in _detail.Participants)
        {
            if (p.ParticipantId == participantId)
                return p.PlayerName ?? p.TankName ?? p.ParticipantId;
        }
        return participantId;
    }

    private static int ParseDamage(string summary)
    {
        int colon = summary.IndexOf(':');
        int hp = summary.LastIndexOf(" HP", StringComparison.Ordinal);
        if (colon < 0 || hp <= colon) return 0;
        string num = summary.AsSpan(colon + 1, hp - colon - 1).Trim().ToString();
        return int.TryParse(num, out int result) ? result : 0;
    }

    private void ComputeStats()
    {
        _dmgTeam1 = _dmgTeam2 = _killsTeam1 = _killsTeam2 = 0;
        if (_detail is null) return;
        foreach (EventResponse evt in _detail.Events)
        {
            if (evt.Kind == "Destroyed")
            {
                int? team = TeamOf(evt.ParticipantId);
                if (team == 1) _killsTeam1++;
                else if (team == 2) _killsTeam2++;
            }
            else if (evt.Kind == "Damage")
            {
                int dmg = ParseDamage(evt.Summary);
                int? team = TeamOf(evt.ParticipantId);
                if (team == 1) _dmgTeam1 += dmg;
                else if (team == 2) _dmgTeam2 += dmg;
            }
        }
    }

    private IEnumerable<EventResponse> FilteredEvents()
    {
        if (_detail is null) yield break;
        foreach (EventResponse evt in _detail.Events)
        {
            if (string.IsNullOrEmpty(_eventKindFilter) || evt.Kind == _eventKindFilter)
                yield return evt;
        }
    }
}
