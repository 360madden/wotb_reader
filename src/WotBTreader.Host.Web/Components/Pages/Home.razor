@page "/"
@using WotBTreader.Host.Web.Contracts
@using WotBTreader.Host.Web.Endpoints
@using WotBTreader.Host.Web.Services
@inject IDashboardReadClient ReadClient

<PageTitle>Sessions</PageTitle>

<h1>Sessions</h1>

@if (_error is not null)
{
    <p class="text-danger" role="alert">@_error</p>
}
else if (_page is null)
{
    @* Loading skeleton — animated shimmer rows *@
    <div class="card-dashboard">
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
    </div>
}
else if (_page.Items.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon">📂</div>
        <div class="empty-state-text">No decoded sessions yet</div>
        <div class="empty-state-hint">Import a replay with the CLI to populate this list.</div>
    </div>
}
else
{
    <div class="card-dashboard">
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th scope="col">Map</th>
                <th scope="col">Date</th>
                <th scope="col">Game version</th>
                <th scope="col">Status</th>
                <th scope="col">P</th>
                <th scope="col">Pos</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (SessionSummaryResponse item in _page.Items)
            {
                string? sessionId = item.Session?.BattleSessionId;
                <tr>
                    <td>@(item.Session?.MapName ?? "unknown")</td>
                    <td class="text-nowrap">@(item.Session?.BattleTimeUtc is { } dt ? dt.ToString("yyyy-MM-dd") : "—")</td>
                    <td>@(item.Session?.GameVersion ?? item.DecodeRun.SchemaVersion)</td>
                    <td><span class="badge @StatusBadgeClass(item.DecodeRun.Status)">@item.DecodeRun.Status</span></td>
                    <td>@item.ParticipantCount</td>
                    <td>@item.PositionCount</td>
                    <td>
                        @if (sessionId is not null)
                        {
                            <a href="@($"sessions/{sessionId}")">Open</a>
                        }
                        else
                        {
                            <span class="text-muted">No session</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>
}

@code {
    private SessionPageResponse? _page;
    private string? _error;

    private static string StatusBadgeClass(string? status) => status switch
    {
        "Succeeded" => "bg-success",
        "Failed" => "bg-danger",
        "Partial" => "bg-warning text-dark",
        _ => "bg-secondary",
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _page = await ReadClient.ListSessionsAsync(
                0,
                ReadApiEndpoints.DefaultPageSize,
                CancellationToken.None);
        }
        catch (Exception exception)
        {
            _error = $"Could not load sessions ({exception.GetType().Name}).";
        }
    }
}
