@page "/"
@using WotBTreader.Host.Web.Contracts
@using WotBTreader.Host.Web.Endpoints
@using WotBTreader.Host.Web.Services
@inject IDashboardReadClient ReadClient

<PageTitle>Sessions</PageTitle>

<div style="display:flex;align-items:center;gap:0.75rem;margin-bottom:1rem">
    <h1 style="margin-bottom:0">Sessions</h1>
    <button class="btn btn-sm btn-outline-secondary" style="font-size:0.8rem;padding:0.2rem 0.6rem"
            @onclick="RefreshAsync" title="Refresh session list">
        ↻ Refresh
    </button>
    @if (_refreshing)
    {
        <span style="font-size:0.8rem;color:var(--text-muted);animation:pulse 1s ease-in-out infinite">⟳</span>
    }
</div>

<style>
    @@keyframes pulse { 0%,100% { opacity:0.4; } 50% { opacity:1; } }
</style>

@if (_error is not null)
{
    <p class="text-danger" role="alert">@_error</p>
}
else if (_page is null)
{
    @* Loading skeleton — animated shimmer rows *@
    <div class="card-dashboard">
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
        <div class="skeleton-row"><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div><div class="skeleton-cell"></div></div>
    </div>
}
else if (_page.Items.Count == 0)
{
    <div class="empty-state">
        <div class="empty-state-icon">📂</div>
        <div class="empty-state-text">No decoded sessions yet</div>
        <div class="empty-state-hint">Import a replay with the CLI to populate this list.</div>
    </div>
}
else
{
    @* ── Metrics cards row ── *@
    <div class="row g-2 mb-3">
        <div class="col-auto">
            <div class="card-dashboard text-center" style="min-width:100px">
                <div style="font-size:0.7rem;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.04em">Sessions</div>
                <div style="font-size:1.6rem;font-weight:600;color:var(--accent-blue)">@_page.Items.Count</div>
            </div>
        </div>
        <div class="col-auto">
            <div class="card-dashboard text-center" style="min-width:100px">
                <div style="font-size:0.7rem;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.04em">Participants</div>
                <div style="font-size:1.6rem;font-weight:600;color:var(--accent-green)">@_totalParticipants.ToString("N0")</div>
            </div>
        </div>
        <div class="col-auto">
            <div class="card-dashboard text-center" style="min-width:100px">
                <div style="font-size:0.7rem;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.04em">Positions</div>
                <div style="font-size:1.6rem;font-weight:600;color:var(--accent-orange)">@_totalPositions.ToString("N0")</div>
            </div>
        </div>
        <div class="col-auto">
            <div class="card-dashboard text-center" style="min-width:100px">
                <div style="font-size:0.7rem;color:var(--text-secondary);text-transform:uppercase;letter-spacing:0.04em">Events</div>
                <div style="font-size:1.6rem;font-weight:600;color:var(--accent-purple)">@_totalEvents.ToString("N0")</div>
            </div>
        </div>
    </div>

    @* ── Search filter ── *@
    <div class="mb-3">
        <input type="text" class="form-control form-control-sm" style="max-width:320px"
               placeholder="🔍  Filter by map name…"
               @bind="_searchFilter" @bind:event="oninput" />
    </div>

    <div class="card-dashboard">
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th scope="col" class="th-sortable @SortClass(SortColumn.Map)" @onclick="() => ToggleSort(SortColumn.Map)">Map</th>
                <th scope="col" class="th-sortable @SortClass(SortColumn.Date)" @onclick="() => ToggleSort(SortColumn.Date)">Date</th>
                <th scope="col" class="th-sortable @SortClass(SortColumn.Version)" @onclick="() => ToggleSort(SortColumn.Version)">Game version</th>
                <th scope="col" class="th-sortable @SortClass(SortColumn.Status)" @onclick="() => ToggleSort(SortColumn.Status)">Status</th>
                <th scope="col" class="th-sortable @SortClass(SortColumn.Participants)" @onclick="() => ToggleSort(SortColumn.Participants)">P</th>
                <th scope="col" class="th-sortable @SortClass(SortColumn.Positions)" @onclick="() => ToggleSort(SortColumn.Positions)">Pos</th>
                <th scope="col"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (SessionSummaryResponse item in SortedItems())
            {
                string? sessionId = item.Session?.BattleSessionId;
                <tr>
                    <td>@(item.Session?.MapName ?? "unknown")</td>
                    <td class="text-nowrap">@(item.Session?.BattleTimeUtc is { } dt ? dt.ToString("yyyy-MM-dd") : "—")</td>
                    <td>@(item.Session?.GameVersion ?? item.DecodeRun.SchemaVersion)</td>
                    <td><span class="badge @StatusBadgeClass(item.DecodeRun.Status)">@item.DecodeRun.Status</span></td>
                    <td>@item.ParticipantCount</td>
                    <td>@item.PositionCount</td>
                    <td>
                        @if (sessionId is not null)
                        {
                            <a href="@($"sessions/{sessionId}")">Open</a>
                        }
                        else
                        {
                            <span class="text-muted">No session</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @if (FilteredCount() < _page.Items.Count)
    {
        <div class="text-muted small mt-1">Showing @FilteredCount() of @_page.Items.Count sessions</div>
    }
    </div>
}

@code {
    private SessionPageResponse? _page;
    private string? _error;
    private string _searchFilter = string.Empty;
    private int _totalParticipants;
    private int _totalPositions;
    private int _totalEvents;
    private bool _refreshing;

    private enum SortColumn { Map, Date, Version, Status, Participants, Positions }
    private SortColumn _sortColumn = SortColumn.Date;
    private bool _sortDesc = true;

    private string SortClass(SortColumn col)
    {
        if (_sortColumn != col) return string.Empty;
        return _sortDesc ? "sort-desc" : "sort-asc";
    }

    private void ToggleSort(SortColumn col)
    {
        if (_sortColumn == col)
            _sortDesc = !_sortDesc;
        else
        {
            _sortColumn = col;
            _sortDesc = false;
        }
    }

    private IEnumerable<SessionSummaryResponse> SortedItems()
    {
        IEnumerable<SessionSummaryResponse> filtered = FilteredItems();
        return (_sortColumn, _sortDesc) switch
        {
            (SortColumn.Map, false) => filtered.OrderBy(i => i.Session?.MapName ?? ""),
            (SortColumn.Map, true) => filtered.OrderByDescending(i => i.Session?.MapName ?? ""),
            (SortColumn.Date, false) => filtered.OrderBy(i => i.Session?.BattleTimeUtc),
            (SortColumn.Date, true) => filtered.OrderByDescending(i => i.Session?.BattleTimeUtc),
            (SortColumn.Version, false) => filtered.OrderBy(i => i.Session?.GameVersion ?? ""),
            (SortColumn.Version, true) => filtered.OrderByDescending(i => i.Session?.GameVersion ?? ""),
            (SortColumn.Status, false) => filtered.OrderBy(i => i.DecodeRun.Status),
            (SortColumn.Status, true) => filtered.OrderByDescending(i => i.DecodeRun.Status),
            (SortColumn.Participants, false) => filtered.OrderBy(i => i.ParticipantCount),
            (SortColumn.Participants, true) => filtered.OrderByDescending(i => i.ParticipantCount),
            (SortColumn.Positions, false) => filtered.OrderBy(i => i.PositionCount),
            (SortColumn.Positions, true) => filtered.OrderByDescending(i => i.PositionCount),
            _ => filtered,
        };
    }

    private int FilteredCount() => FilteredItems().Count();

    private async Task RefreshAsync()
    {
        _refreshing = true;
        _error = null;
        try
        {
            _page = await ReadClient.ListSessionsAsync(
                0,
                ReadApiEndpoints.DefaultPageSize,
                CancellationToken.None);
            _totalParticipants = _page.Items.Sum(i => i.ParticipantCount);
            _totalPositions = _page.Items.Sum(i => i.PositionCount);
            _totalEvents = _page.Items.Sum(i => i.EventCount);
        }
        catch (Exception exception)
        {
            _error = $"Could not load sessions ({exception.GetType().Name}).";
        }
        finally
        {
            _refreshing = false;
        }
    }

    private static string StatusBadgeClass(string? status) => status switch
    {
        "Succeeded" => "bg-success",
        "Failed" => "bg-danger",
        "Partial" => "bg-warning text-dark",
        _ => "bg-secondary",
    };

    private IEnumerable<SessionSummaryResponse> FilteredItems()
    {
        if (_page is null) yield break;
        string filter = _searchFilter.Trim();
        foreach (SessionSummaryResponse item in _page.Items)
        {
            if (filter.Length == 0 ||
                (item.Session?.MapName ?? "").Contains(filter, StringComparison.OrdinalIgnoreCase) ||
                (item.Session?.MapId ?? "").Contains(filter, StringComparison.OrdinalIgnoreCase))
            {
                yield return item;
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _page = await ReadClient.ListSessionsAsync(
                0,
                ReadApiEndpoints.DefaultPageSize,
                CancellationToken.None);

            // Compute summary stats
            _totalParticipants = _page.Items.Sum(i => i.ParticipantCount);
            _totalPositions = _page.Items.Sum(i => i.PositionCount);
            _totalEvents = _page.Items.Sum(i => i.EventCount);
        }
        catch (Exception exception)
        {
            _error = $"Could not load sessions ({exception.GetType().Name}).";
        }
    }
}
