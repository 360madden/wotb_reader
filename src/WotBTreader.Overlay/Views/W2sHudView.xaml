<UserControl x:Class="WotBTreader.Overlay.Views.W2sHudView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{x:Null}">
    <Grid>
        <!-- The per-frame HUD is explicitly non-hit-testable so clicks over the
             game footage still fall through to the window (drag-to-move). The
             playback scrub region below is the one interactive element. -->
        <Canvas x:Name="HudCanvas" ClipToBounds="True" IsHitTestVisible="False"/>
        <Border x:Name="PlaybackScrubRegion"
                Visibility="Collapsed"
                Background="Transparent"
                Cursor="SizeWE"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Left"
                MouseLeftButtonDown="PlaybackScrubRegion_MouseLeftButtonDown"
                MouseMove="PlaybackScrubRegion_MouseMove"
                MouseLeftButtonUp="PlaybackScrubRegion_MouseLeftButtonUp"/>
    </Grid>
</UserControl>
