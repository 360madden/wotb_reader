<Window x:Class="WotBTreader.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WotBTreader.Overlay.Views"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="1200" Height="700"
        AllowDrop="True"
        DragEnter="Window_DragEnter"
        Drop="Window_Drop"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <views:PositionPlot PointsSource="{Binding Points}" IsHitTestVisible="False"
                            WorldMinX="{Binding WorldMinX}" WorldMaxX="{Binding WorldMaxX}"
                            WorldMinZ="{Binding WorldMinZ}" WorldMaxZ="{Binding WorldMaxZ}"
                            MapName="{Binding MapName}"/>
        <Border x:Name="SidebarBorder" HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="340" Margin="12" Padding="8"
                Background="#CC111111" CornerRadius="6"
                BorderBrush="#44FFFFFF" BorderThickness="1" Opacity="0.85">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                    <Button Content="⏮" Command="{Binding JumpToStartCommand}"
                            Width="22" Height="22" FontSize="10"
                            Background="#44FFFFFF" Foreground="White" BorderThickness="0"
                            Padding="0" Cursor="Hand"
                            ToolTip="Jump to start"/>
                    <Button x:Name="PlayButton" Content="▶" Command="{Binding PlayPauseCommand}"
                            Width="24" Height="22"
                            Background="#33AAFF" Foreground="White" BorderThickness="0"
                            Padding="0" Cursor="Hand" FontSize="12" Margin="2,0,0,0"
                            ToolTip="Play / Pause replay timeline"/>
                    <Button Content="⏭" Command="{Binding JumpToEndCommand}"
                            Width="22" Height="22" FontSize="10"
                            Background="#44FFFFFF" Foreground="White" BorderThickness="0"
                            Padding="0" Cursor="Hand" Margin="2,0,0,0"
                            ToolTip="Jump to end"/>
                    <Button Content="{Binding SpeedLabel}" Command="{Binding CycleSpeedCommand}"
                            Width="28" Height="22" FontSize="9"
                            Background="#44FFFFFF" Foreground="#AAFFAA" BorderThickness="0"
                            Padding="0" Cursor="Hand" Margin="2,0,0,0"
                            ToolTip="Cycle playback speed (0.5x / 1x / 2x / 4x / 8x)"/>
                    <Button Content="📂 Pick &amp; Launch" Click="QuickLaunch_Click"
                            Background="#44FF44" Foreground="#111" BorderThickness="0"
                            Padding="8,3" Cursor="Hand" Margin="6,0,0,0"
                            FontWeight="Bold" FontSize="11"
                            ToolTip="Pick a .wotbreplay file — auto-starts host, imports, and launches the game"/>
                    <Button Content="🚀 Re-launch" Command="{Binding LaunchGameCommand}"
                            Background="#33AAFF" Foreground="White" BorderThickness="0"
                            Padding="8,3" Cursor="Hand" Margin="4,0,0,0"
                            FontSize="11"
                            ToolTip="Re-launch wotblitz.exe with the selected session's replay"/>
                    <Button Content="↻" Command="{Binding RefreshCommand}"
                            Width="28" Height="22"
                            Background="#44FFFFFF" Foreground="White" BorderThickness="0"
                            Padding="0" Cursor="Hand" Margin="2,0,0,0"
                            ToolTip="Refresh sessions"/>
                    <Button Content="🌐" Click="OpenDashboardInBrowser"
                            Width="28" Height="22"
                            Background="#44FFFFFF" Foreground="White" BorderThickness="0"
                            Padding="0" Cursor="Hand" Margin="2,0,0,0"
                            ToolTip="Open the full dashboard in a browser"/>
                    <Button Content="👁" Click="ToggleSidebarOpacity"
                            Background="#44FFFFFF" Foreground="#CCCCCC" BorderThickness="0"
                            Width="22" Height="22" FontSize="11" Padding="0"
                            Cursor="Hand" Margin="6,0,0,0"
                            ToolTip="Toggle sidebar transparency"/>
                    <Button x:Name="CollapseButton" Content="«" Click="ToggleSidebarCollapse"
                            Background="#44FFFFFF" Foreground="#CCCCCC" BorderThickness="0"
                            Width="22" Height="22" FontSize="11" Padding="0"
                            Cursor="Hand" Margin="2,0,0,0"
                            ToolTip="Collapse / expand sidebar"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="{Binding Status}"
                           Foreground="#AAFFFFFF" FontSize="11" Margin="0,0,0,4"/>
                <TextBlock x:Name="GamePathInfo" Grid.Row="2"
                           Foreground="#66FFFFFF" FontSize="9" Margin="0,0,0,2"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="Discovered game path and replays folder.\nSet WOTB_GAME_PATH env var to override."/>
                <TextBox Grid.Row="3" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Background="#22FFFFFF" Foreground="White" BorderThickness="0"
                         FontSize="11" Padding="4,2" Margin="0,0,0,2"
                         MaxLines="1"
                         ToolTip="Filter sessions by map name"/>
                <ListBox x:Name="SessionsListBox" Grid.Row="4" ItemsSource="{Binding FilteredSessions}"
                         SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="White" Height="160" MaxHeight="160">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding MapLabel}" FontWeight="Bold"
                                           FontSize="12" Foreground="White"/>
                                <TextBlock FontSize="10" Foreground="#AAFFFFFF">
                                    <Run Text="{Binding BattleTimeUtc}"/><Run Text=" • "/>
                                    <Run Text="{Binding ParticipantCount}"/><Run Text="p • "/>
                                    <Run Text="{Binding PositionCount}"/><Run Text=" pos"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- Timeline scrubber -->
                <Grid x:Name="TimelineGrid" Grid.Row="5" Margin="0,2,0,2"
                      Visibility="{Binding SelectedSession, Converter={StaticResource NullToCollapsed}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" FontSize="9" Foreground="#AAFFFFFF"
                               VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Run Text="{Binding CurrentTime, StringFormat={}{0:mm\\:ss}}"/>
                    </TextBlock>
                    <Slider Grid.Column="1" Minimum="0"
                            Maximum="{Binding Duration.TotalSeconds}"
                            Value="{Binding CurrentTimeSeconds}"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            Background="#33FFFFFF" Foreground="#33AAFF"
                            Height="20" Cursor="Hand"/>
                </Grid>
                <!-- Session detail panel -->
                <Grid x:Name="DetailGrid" Grid.Row="6" Margin="0,4,0,0"
                      Visibility="{Binding SelectedSession, Converter={StaticResource NullToCollapsed}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" FontSize="11" Foreground="#AAFFFFFF" Margin="0,0,0,3">
                        <Run Text="👥 Participants ("/><Run Text="{Binding Participants.Count}"/><Run Text=")"/>
                    </TextBlock>
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Participants}" MaxHeight="120">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <Ellipse Width="7" Height="7" Margin="0,0,4,0">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding TeamNumber, Converter={StaticResource TeamToColor}}"/>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock FontSize="10" Foreground="White">
                                        <Run Text="{Binding PlayerName, TargetNullValue='—'}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="9" Foreground="#88FFFFFF" Margin="4,0,0,0">
                                        <Run Text="{Binding TankName, TargetNullValue=''}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Row="2" FontSize="10" Foreground="#88FFFFFF" Margin="0,3,0,0">
                        <Run Text="📊 Events: "/><Run Text="{Binding EventCount}"/>
                    </TextBlock>
                    <!-- Battle stats bar -->
                    <Grid Grid.Row="3" Margin="0,3,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock FontSize="9" Foreground="DodgerBlue">
                                <Run Text="🔵 "/><Run Text="{Binding DamageTeam1, StringFormat='{}{0:N0}'}"/><Run Text=" dmg taken"/>
                            </TextBlock>
                            <TextBlock FontSize="9" Foreground="DodgerBlue">
                                <Run Text="{Binding KillsTeam1, StringFormat='{}{0}'}"/><Run Text=" kills"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock FontSize="9" Foreground="OrangeRed">
                                <Run Text="🔴 "/><Run Text="{Binding DamageTeam2, StringFormat='{}{0:N0}'}"/><Run Text=" dmg taken"/>
                            </TextBlock>
                            <TextBlock FontSize="9" Foreground="OrangeRed">
                                <Run Text="{Binding KillsTeam2, StringFormat='{}{0}'}"/><Run Text=" kills"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                    <ItemsControl Grid.Row="4" ItemsSource="{Binding Events}" MaxHeight="80" Margin="0,3,0,0">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="EventItem_Click">
                                    <TextBlock FontSize="9" Foreground="#88FFFFFF" Width="48">
                                        <Run Text="{Binding ReplayTime, StringFormat={}{0:mm\\:ss}}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="9" Foreground="#CCFFFFFF">
                                        <Run Text="{Binding Summary}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
                <Button x:Name="CloseButton" Grid.Row="7" Content="✕ Close" Click="CloseWindow"
                        Background="#33FF4444" Foreground="White" BorderThickness="0"
                        Padding="8,3" Margin="0,4,0,0" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
