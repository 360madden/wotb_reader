<Window x:Class="WotBTreader.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:WotBTreader.Overlay.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="1200" Height="700"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        PreviewKeyDown="Window_PreviewKeyDown"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>

        <!-- ═══ Button style — translucent, rounded, with hover/pressed states ═══ -->
        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#CCFFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="#33FFFFFF" CornerRadius="4"
                                BorderThickness="0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ListBox item hover/selection style ═══ -->
        <Style x:Key="SessionListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}"
                                BorderThickness="0">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33446688"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3366AA"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="0,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ ScrollBar for dark theme ═══ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="5"/>
        </Style>

        <!-- ═══ Converters ═══ -->
        <BooleanToVisibilityConverter x:Key="BoolToVisible"/>

    </Window.Resources>

    <Grid>
        <!-- ═══ Position plot fills the entire window ═══ -->
        <views:PositionPlot PointsSource="{Binding Points}" IsHitTestVisible="False"
                            WorldMinX="{Binding WorldMinX}" WorldMaxX="{Binding WorldMaxX}"
                            WorldMinZ="{Binding WorldMinZ}" WorldMaxZ="{Binding WorldMaxZ}"
                            MapName="{Binding MapName}"
                            MinimapImage="{Binding MinimapImageSource}"
                            LivePlayerX="{Binding LivePlayerPositionX}"
                            LivePlayerZ="{Binding LivePlayerPositionZ}"
                            LivePlayerTrail="{Binding LivePlayerTrail}"/>

        <!-- ═══ W2S HUD — projected nameplates over the game view ═══ -->
        <views:W2sHudView x:Name="W2sHudView" IsHitTestVisible="False"/>

        <!-- ═══ Live HP overlay — bottom-left corner of the window ═══ -->
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="16,0,0,16" Padding="10,6" CornerRadius="6"
                Background="#CC0D0D14" BorderBrush="#44FFFFFF" BorderThickness="1"
                Visibility="{Binding HasLiveMemoryObservation, Converter={StaticResource BoolToVisible}}"
                IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="❤️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock FontSize="16" FontWeight="Bold" Foreground="#00FF64"
                           VerticalAlignment="Center" FontFamily="Consolas">
                    <Run Text="{Binding LivePlayerHP, Mode=OneWay, TargetNullValue='—', StringFormat={}{0}}"/>
                    <Run Text=" HP" FontSize="11" Foreground="#88FFFFFF" FontWeight="Normal"/>
                </TextBlock>
                <Border Width="1" Margin="8,2" Background="#22FFFFFF" VerticalAlignment="Stretch"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="9" Foreground="#66FFFFFF">
                        <Run Text="⏱ "/>
                        <Run Text="{Binding LiveReplayTimeSeconds, Mode=OneWay, StringFormat={}{0:F1}}"/>
                        <Run Text="s"/>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ═══ Sidebar panel — gradient, shadowed, rounded ═══ -->
        <Border x:Name="SidebarBorder" HorizontalAlignment="Right" VerticalAlignment="Top"
                Width="350" Margin="14" Padding="10" CornerRadius="8"
                BorderBrush="#55FFFFFF" BorderThickness="1" Opacity="0.92"
                UseLayoutRounding="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="3" Opacity="0.5"/>
            </Border.Effect>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#DD1A1A24" Offset="0"/>
                    <GradientStop Color="#DD0D0D14" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ═══ Row 0: Toolbar ═══ -->
                <Border Grid.Row="0" Margin="0,0,0,8" Padding="0,0,0,6"
                        BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <!-- Transport controls -->
                        <Button Content="⏮" ToolTip="Jump to start (Home)" Style="{StaticResource ToolbarButton}"
                                Command="{Binding JumpToStartCommand}" Width="24" Height="24" FontSize="10"/>
                        <Button x:Name="PlayButton" Content="▶" ToolTip="Play / Pause (Space)" Style="{StaticResource ToolbarButton}"
                                Command="{Binding PlayPauseCommand}" Width="28" Height="24" FontSize="12"
                                Foreground="#33AAFF" Margin="2,0,0,0"/>
                        <Button Content="⏭" ToolTip="Jump to end (End)" Style="{StaticResource ToolbarButton}"
                                Command="{Binding JumpToEndCommand}" Width="24" Height="24" FontSize="10"
                                Margin="2,0,0,0"/>
                        <Button Content="{Binding SpeedLabel}" ToolTip="Cycle speed (1-5)" Style="{StaticResource ToolbarButton}"
                                Command="{Binding CycleSpeedCommand}" Width="30" Height="24" FontSize="9"
                                Foreground="#AAFFAA" Margin="2,0,0,0"/>

                        <!-- HUD field of view (vertical degrees) -->
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="FOV" FontSize="9" Foreground="#88FFFFFF"
                                       VerticalAlignment="Center" Margin="0,0,3,0"/>
                            <Slider Width="80" Minimum="40" Maximum="120"
                                    Value="{Binding HudFovDegrees, Mode=TwoWay}"
                                    ToolTip="Vertical field of view used to project the HUD"
                                    Height="18" VerticalAlignment="Center" Cursor="Hand"/>
                        </StackPanel>

                        <!-- Live HUD mode: the gated composed live frame (LiveFrameSource seam) -->
                        <CheckBox Content="Live" IsChecked="{Binding IsLiveMode, Mode=TwoWay}"
                                  Foreground="#AAFFAA" FontSize="9" VerticalAlignment="Center"
                                  Margin="8,0,0,0"
                                  ToolTip="Render the gated live frame (memory reads: roster -&gt; batch -&gt; camera) instead of the decoded replay projection"/>

                        <!-- Primary action: Refresh -->
                        <Button Content="↻" ToolTip="Refresh sessions" Style="{StaticResource ToolbarButton}"
                                Command="{Binding RefreshCommand}" Width="24" Height="24" Margin="6,0,0,0"/>
                        <Button Content="🌐" ToolTip="Open dashboard in browser" Style="{StaticResource ToolbarButton}"
                                Click="OpenDashboardInBrowser" Width="24" Height="24" Margin="2,0,0,0"/>
                        <Button Content="ⓘ" ToolTip="Export privacy-safe HUD diagnostics" Style="{StaticResource ToolbarButton}"
                                Click="ExportDiagnostics" Width="24" Height="24" Margin="2,0,0,0"/>
                        <Button Content="👁" ToolTip="Toggle sidebar opacity" Style="{StaticResource ToolbarButton}"
                                Click="ToggleSidebarOpacity" Width="24" Height="24" Margin="6,0,0,0"
                                Foreground="#999"/>
                        <Button x:Name="CompactButton" Content="⊟" ToolTip="Toggle compact mode"
                                Style="{StaticResource ToolbarButton}" Click="ToggleCompactMode"
                                Width="24" Height="24" Margin="2,0,0,0" Foreground="#888" FontSize="10"/>
                        <Button x:Name="CollapseButton" Content="«" ToolTip="Collapse sidebar (\\)"
                                Style="{StaticResource ToolbarButton}" Click="ToggleSidebarCollapse"
                                Width="24" Height="24" Margin="2,0,0,0" Foreground="#999"/>
                    </StackPanel>
                </Border>

                <!-- ═══ Row 1: Explicit runtime diagnostics + penetration state ═══ -->
                <StackPanel Grid.Row="1" Margin="0,0,0,6">
                    <Border Padding="6,5" Margin="0,0,0,5"
                            Background="#18FFFFFF" BorderBrush="{Binding RuntimeStateAccent}"
                            BorderThickness="1" CornerRadius="5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="●" FontSize="12"
                                       Foreground="{Binding RuntimeStateAccent}"
                                       VerticalAlignment="Top" Margin="0,0,6,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding RuntimeStateLabel}"
                                           Foreground="{Binding RuntimeStateAccent}"
                                           FontSize="10" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding RuntimeStateDetail}"
                                           Foreground="#CCFFFFFF" FontSize="9"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding FrameStatusLabel}"
                                           Foreground="#77FFFFFF" FontSize="8"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding GameWindowStatusLabel}"
                                           Foreground="{Binding GameWindowStatusAccent}" FontSize="8"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding FrameHealthLabel}"
                                           Foreground="#77FFFFFF" FontSize="8"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding RenderHealthLabel}"
                                           Foreground="#77FFFFFF" FontSize="8"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Status}"
                               Foreground="#BBFFFFFF" FontSize="11" Margin="0,0,0,2"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding HudUiVersionLabel}"
                               Foreground="#66FFFFFF" FontSize="8"
                               HorizontalAlignment="Right" Margin="0,0,0,4"/>
                    <Border Padding="4,3" Background="#10FFFFFF" CornerRadius="4"
                            Visibility="{Binding HasPenShells, Converter={StaticResource BoolToVisible}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🛡 Shell" FontSize="9" Foreground="#88FFFFFF"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding PenShells}"
                                      SelectedValuePath="Name"
                                      SelectedValue="{Binding SelectedPenShellName, Mode=TwoWay}"
                                      MinWidth="150" FontSize="10"
                                      Background="#22FFFFFF" Foreground="White"
                                      BorderBrush="#44FFFFFF" Cursor="Hand">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding ShortLabel, Mode=OneWay}" FontWeight="SemiBold" Foreground="#AAFFAA"/>
                                            <Run Text="  "/>
                                            <Run Text="{Binding Name, Mode=OneWay}" Foreground="#CCFFFFFF"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding PenReadinessLabel}"
                               Visibility="{Binding HasPenReadiness, Converter={StaticResource BoolToVisible}}"
                               Margin="0,2,0,0" FontSize="9" Foreground="#99FFFFFF"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ═══ Row 2: Search ═══ -->
                <Border Grid.Row="2" Margin="0,0,0,4" Background="#1AFFFFFF"
                        CornerRadius="4" BorderBrush="#22FFFFFF" BorderThickness="1">
                    <Grid>
                        <TextBlock Text="🔍  Filter maps…" IsHitTestVisible="False"
                                   Foreground="#44FFFFFF" FontSize="11" VerticalAlignment="Center"
                                   Margin="8,0" Visibility="Visible" x:Name="SearchPlaceholder"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="White" BorderThickness="0"
                                 FontSize="11" Padding="8,4" MaxLines="1"
                                 ToolTip="Filter sessions by map name"
                                 TextChanged="SearchText_TextChanged"/>
                    </Grid>
                </Border>

                <!-- ═══ Row 3: Session list ═══ -->
                <ListBox x:Name="SessionsListBox" Grid.Row="3"
                         ItemsSource="{Binding FilteredSessions}"
                         SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0"
                         Foreground="White" Height="150" MaxHeight="150"
                         ItemContainerStyle="{StaticResource SessionListBoxItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding MapLabel}" FontWeight="SemiBold"
                                           FontSize="12" Foreground="White"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock FontSize="9" Foreground="#88FFFFFF"
                                               Text="{Binding BattleTimeUtc, StringFormat={}{0:MMM dd  HH:mm}}"/>
                                    <TextBlock FontSize="9" Foreground="#66FFFFFF" Margin="6,0,0,0">
                                        <Run Text="{Binding ParticipantCount, Mode=OneWay}"/><Run Text="p"/>
                                    </TextBlock>
                                    <TextBlock FontSize="9" Foreground="#66FFFFFF" Margin="6,0,0,0">
                                        <Run Text="{Binding PositionCount, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                        <Run Text=" pos"/>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="3" Margin="4,8" Padding="10,8"
                        Background="#14FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1"
                        CornerRadius="5" IsHitTestVisible="False"
                        Visibility="{Binding HasSessionListEmptyState, Converter={StaticResource BoolToVisible}}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding SessionListEmptyStateTitle}"
                                   Foreground="#CCFFFFFF" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="{Binding SessionListEmptyStateDetail}"
                                   Foreground="#88FFFFFF" FontSize="9" Margin="0,3,0,0"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="250"/>
                    </StackPanel>
                </Border>

                <!-- ═══ Row 4: Timeline scrubber ═══ -->
                <Border x:Name="TimelineGrid" Grid.Row="4" Margin="0,4,0,4" Padding="4,3"
                        Background="#14FFFFFF" CornerRadius="4"
                        Visibility="{Binding SelectedSession, Converter={StaticResource NullToCollapsed}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="10" Foreground="#AAFFFFFF"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   FontFamily="Consolas">
                            <Run Text="{Binding CurrentTime, Mode=OneWay, StringFormat={}{0:mm\\:ss}}"/>
                        </TextBlock>
                        <TextBlock Grid.Column="1" FontSize="10" Foreground="#55FFFFFF"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontFamily="Consolas" Margin="0,0,6,0">
                            <Run Text="{Binding Duration, Mode=OneWay, StringFormat={}{0:mm\\:ss}}"/>
                        </TextBlock>
                        <Slider Grid.Column="2" Minimum="0"
                                Maximum="{Binding Duration.TotalSeconds, Mode=OneWay}"
                                Value="{Binding CurrentTimeSeconds}"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Height="18" Cursor="Hand"
                                VerticalAlignment="Center">
                            <Slider.Template>
                                <ControlTemplate TargetType="Slider">
                                    <Grid>
                                        <Track x:Name="PART_Track" Height="4">
                                            <Track.DecreaseRepeatButton>
                                                <RepeatButton Command="Slider.DecreaseLarge">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate>
                                                            <Rectangle Fill="#33AAFF" RadiusX="2" RadiusY="2"/>
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.DecreaseRepeatButton>
                                            <Track.Thumb>
                                                <Thumb Width="10" Height="16" Cursor="Hand">
                                                    <Thumb.Template>
                                                        <ControlTemplate>
                                                            <Rectangle Fill="#66CCFF" RadiusX="3" RadiusY="3"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                            <Track.IncreaseRepeatButton>
                                                <RepeatButton Command="Slider.IncreaseLarge">
                                                    <RepeatButton.Template>
                                                        <ControlTemplate>
                                                            <Rectangle Fill="#22FFFFFF" RadiusX="2" RadiusY="2"/>
                                                        </ControlTemplate>
                                                    </RepeatButton.Template>
                                                </RepeatButton>
                                            </Track.IncreaseRepeatButton>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Slider.Template>
                        </Slider>
                    </Grid>
                </Border>

                <!-- ═══ Row 5: Session detail panel ═══ -->
                <Grid x:Name="DetailGrid" Grid.Row="5" Margin="0,2,0,0"
                      Visibility="{Binding SelectedSession, Converter={StaticResource NullToCollapsed}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- ── Participants header ── -->
                    <Border Grid.Row="1" Margin="0,0,0,4" Padding="0,0,0,4"
                            BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                        <TextBlock FontSize="11" Foreground="#BBFFFFFF">
                            <Run Text="👥  Participants ("/>
                            <Run Text="{Binding Participants.Count, Mode=OneWay}" Foreground="#88CCFF"/>
                            <Run Text=")"/>
                        </TextBlock>
                    </Border>

                    <!-- ── Participants list ── -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Participants}" MaxHeight="110">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,1" Padding="3,2" CornerRadius="3"
                                        Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#15FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0"
                                                 VerticalAlignment="Center">
                                            <Ellipse.Fill>
                                                <SolidColorBrush Color="{Binding TeamNumber, Converter={StaticResource TeamToColor}}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock FontSize="10" Foreground="White"
                                                   VerticalAlignment="Center" MinWidth="70"
                                                   Text="{Binding PlayerName, TargetNullValue='—'}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock FontSize="9" Foreground="#77FFFFFF"
                                                   VerticalAlignment="Center" Margin="4,0,0,0"
                                                   Text="{Binding TankName, TargetNullValue=''}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── Event count ── -->
                    <TextBlock Grid.Row="3" FontSize="10" Foreground="#88FFFFFF" Margin="0,4,0,0">
                        <Run Text="📊  Events: "/>
                        <Run Text="{Binding EventCount, Mode=OneWay}" Foreground="#88CCFF"/>
                    </TextBlock>

                    <!-- ── Battle stats bar ── -->
                    <Border Grid.Row="4" Margin="0,4,0,0" Padding="4,3"
                            Background="#10FFFFFF" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock FontSize="9" Foreground="#55AAFF" FontWeight="SemiBold">
                                    <Run Text="🔵  TEAM 1"/>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#88CCFF" Margin="0,1,0,0">
                                    <Run Text="{Binding DamageTeam1, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                    <Run Text=" dmg" Foreground="#66FFFFFF" FontSize="9"/>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#88CCFF">
                                    <Run Text="{Binding KillsTeam1, Mode=OneWay, StringFormat={}{0}}"/>
                                    <Run Text=" kills" Foreground="#66FFFFFF" FontSize="9"/>
                                </TextBlock>
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Margin="6,2"
                                    Background="#22FFFFFF" VerticalAlignment="Stretch"/>
                            <StackPanel Grid.Column="2">
                                <TextBlock FontSize="9" Foreground="#FF6644" FontWeight="SemiBold">
                                    <Run Text="🔴  TEAM 2"/>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#FF8866" Margin="0,1,0,0">
                                    <Run Text="{Binding DamageTeam2, Mode=OneWay, StringFormat={}{0:N0}}"/>
                                    <Run Text=" dmg" Foreground="#66FFFFFF" FontSize="9"/>
                                </TextBlock>
                                <TextBlock FontSize="10" Foreground="#FF8866">
                                    <Run Text="{Binding KillsTeam2, Mode=OneWay, StringFormat={}{0}}"/>
                                    <Run Text=" kills" Foreground="#66FFFFFF" FontSize="9"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ── Event feed ── -->
                    <ItemsControl Grid.Row="5" ItemsSource="{Binding Events}" MaxHeight="72" Margin="0,3,0,0">
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,1" Padding="3,2" CornerRadius="3"
                                        Cursor="Hand" MouseLeftButtonDown="EventItem_Click"
                                        Background="Transparent">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#18FFFFFF"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontSize="9" Foreground="#66FFFFFF" Width="44"
                                                   FontFamily="Consolas"
                                                   Text="{Binding ReplayTime, StringFormat={}{0:mm\\:ss}}"
                                                   VerticalAlignment="Center"/>
                                        <!-- Event icon + color-coded summary -->
                                        <TextBlock x:Name="EventIcon" FontSize="9" Width="14"
                                                   VerticalAlignment="Center" Margin="2,0,2,0"
                                                   Foreground="#66FFFFFF"/>
                                        <TextBlock x:Name="EventSummary" FontSize="9"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Summary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <!-- Damage: red -->
                                    <DataTrigger Binding="{Binding Kind}" Value="Damage">
                                        <Setter TargetName="EventIcon" Property="Text" Value="💥"/>
                                        <Setter TargetName="EventSummary" Property="Foreground" Value="#FF6644"/>
                                    </DataTrigger>
                                    <!-- Destroyed: orange-red, semi-bold -->
                                    <DataTrigger Binding="{Binding Kind}" Value="Destroyed">
                                        <Setter TargetName="EventIcon" Property="Text" Value="💀"/>
                                        <Setter TargetName="EventSummary" Property="Foreground" Value="#FF8866"/>
                                        <Setter TargetName="EventSummary" Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <!-- BattleStarted: green -->
                                    <DataTrigger Binding="{Binding Kind}" Value="BattleStarted">
                                        <Setter TargetName="EventIcon" Property="Text" Value="🚩"/>
                                        <Setter TargetName="EventSummary" Property="Foreground" Value="#66DD88"/>
                                    </DataTrigger>
                                    <!-- BattleEnded: gray -->
                                    <DataTrigger Binding="{Binding Kind}" Value="BattleEnded">
                                        <Setter TargetName="EventIcon" Property="Text" Value="🏁"/>
                                        <Setter TargetName="EventSummary" Property="Foreground" Value="#889999"/>
                                    </DataTrigger>
                                    <!-- ParticipantObserved: blue -->
                                    <DataTrigger Binding="{Binding Kind}" Value="ParticipantObserved">
                                        <Setter TargetName="EventIcon" Property="Text" Value="👤"/>
                                        <Setter TargetName="EventSummary" Property="Foreground" Value="#66AAFF"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- ═══ Row 6: Close button ═══ -->
                <Button x:Name="CloseButton" Grid.Row="6" Content="✕  Close"
                        Click="CloseWindow"
                        Height="28" FontSize="11" FontWeight="SemiBold"
                        Cursor="Hand" Margin="0,6,0,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="#33CC4444" CornerRadius="5"
                                    BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextBlock.Foreground="#FF8888" TextBlock.FontWeight="SemiBold"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#55CC4444"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#22CC4444"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>
    </Grid>
</Window>
