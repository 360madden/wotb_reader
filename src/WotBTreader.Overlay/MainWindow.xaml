<Window x:Class="WotBTreader.Overlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:views="clr-namespace:WotBTreader.Overlay.Views"
        mc:Ignorable="d"
        Title="WotB Treader Overlay" Width="1200" Height="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ToolBar Grid.Row="0">
            <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </ToolBar>
        <TabControl Grid.Row="1" Margin="4">
            <TabItem Header="Position Plot">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ListBox Grid.Column="0"
                             ItemsSource="{Binding Sessions}"
                             SelectedItem="{Binding SelectedSession, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding MapLabel}" FontWeight="Bold"/>
                                    <TextBlock FontSize="11" Foreground="Gray">
                                        <Run Text="{Binding BattleTimeUtc}"/>
                                        <Run Text=" • "/>
                                        <Run Text="{Binding ParticipantCount}"/>
                                        <Run Text=" players • "/>
                                        <Run Text="{Binding PositionCount}"/>
                                        <Run Text=" samples"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <views:PositionPlot Grid.Column="1" PointsSource="{Binding Points}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Dashboard">
                <Grid>
                    <TextBlock x:Name="DashboardFallback"
                               Text="WebView2 runtime not available. Install Microsoft Edge WebView2 to use the embedded dashboard."
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="40"
                               FontSize="14"
                               Foreground="Gray"/>
                    <wpf:WebView2 x:Name="DashboardView" Visibility="Collapsed"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
