# Keep the index lean. Tracked source stays searchable; build noise does not.
**/bin/
**/obj/
**/.vs/
**/TestResults/
**/coverage/
**/*.user
**/*.suo
**/node_modules/

# Secrets and machine-local configuration.
.env
.env.*
**/.env
**/.env.*
**/*.rendezvous.json
**/appsettings.Local.json
**/launchSettings.Local.json

# Private/runtime/game-derived data must never enter model context.
.data/
.data.bak/
captures/
diagnostics/
imports/
private-fixtures/
replay-cache/
screenshots/
telemetry/
memory-offsets/
tools/external/installed/
tools/external/downloads/
tools/external/cache/
**/*.wotbreplay
**/*.db
**/*.db-shm
**/*.db-wal
**/*.sqlite
**/*.sqlite3
**/*.log
**/*.dmp
**/*.dump
**/*.ptr
**/*.scandata
**/*.CT
