{
  "description": "Reviewed-model and reviewed-role guardrails for root sessions and subagent spawns (gpt-5.6-sol all lanes; deepseek-v4-pro bounded lanes; overrides denied).",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command '& { $repoRoot = git rev-parse --show-toplevel; & (Join-Path $repoRoot \".codex/hooks/enforce-allowed-models.ps1\") }'",
            "timeout": 10,
            "statusMessage": "Checking the allowed-model policy"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|collaboration[._]spawn_agent|functions[._]collaboration[._]spawn_agent)$",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command '& { $repoRoot = git rev-parse --show-toplevel; & (Join-Path $repoRoot \".codex/hooks/enforce-allowed-models.ps1\") }'",
            "timeout": 10,
            "statusMessage": "Checking the allowed-model subagent policy"
          }
        ]
      }
    ]
  }
}