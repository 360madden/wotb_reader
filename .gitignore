# Local environment and secrets
.env
.env.*
!.env.example

# Editor and OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp
*~

# Logs and temporary files
*.log
tmp/
temp/

# Common dependency and build output
node_modules/
dist/
build/
coverage/
artifacts/
bin/
obj/
TestResults/
.vs/
*.user
*.suo
*.nupkg
*.snupkg
packages/

# Python caches and virtual environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# WotB Treader private/runtime data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
!src/WotBTreader.Storage.Sqlite/
!src/WotBTreader.Storage.Sqlite/**
!tests/WotBTreader.Storage.Sqlite.Tests/
!tests/WotBTreader.Storage.Sqlite.Tests/**
bin/
obj/
TestResults/
*.wotbreplay
!tests/fixtures/**/*.wotbreplay
captures/
diagnostics/
imports/
private-fixtures/
replay-cache/
screenshots/
telemetry/
tools/external/installed/
tools/external/downloads/
tools/external/cache/

# Source-tree folders that the runtime data patterns above must never hide.
# Windows worktrees compare ignore patterns case-insensitively (BLK-0005).
!src/**/Diagnostics/
!src/**/Diagnostics/**
!src/**/wwwroot/lib/
!src/**/wwwroot/lib/**

# Local rendezvous and machine-specific settings
*.rendezvous.json
appsettings.Local.json
launchSettings.Local.json
